<?xml version="1.0" encoding="UTF-8"?>
<ServerManagerConfiguration>
  <ProxyGroup name="filters">
    <SourceProxy name="ttkTrajectoryStatistics" class="ttkTrajectoryStatistics" label="TTK TrajectoryStatistics">
      <Documentation long_help="Trajectory Stat" short_help="Trajectory statistics after Tracking From Field"/>

      <!-- INPUT DATA OBJECT -->
      <InputProperty name="InputGrid" command="SetInputConnection" port_index="0">
        <ProxyGroupDomain name="groups">
          <Group name="sources"/>
          <Group name="filters"/>
        </ProxyGroupDomain>
        <DataTypeDomain name="input_type">
          <DataType value="vtkUnstructuredGrid"/>
        </DataTypeDomain>
        <Documentation>Output From TrackingFromField.</Documentation>
      </InputProperty>

      <InputProperty name="InputSet" command="SetInputConnection" port_index="1">
        <ProxyGroupDomain name="groups">
          <Group name="sources"/>
          <Group name="filters"/>
        </ProxyGroupDomain>
        <DataTypeDomain name="input_type">
          <DataType value="vtkDataSet"/>
        </DataTypeDomain>
        <Documentation>Initial Data</Documentation>
      </InputProperty>

      <!-- OUTPUT PARAMETER WIDGETS -->



      <IntVectorProperty
        name="frameSurface"
        command="SetframeSurface"
        label="Frame Surface"
        number_of_elements="1"
        default_values="0">
        <Documentation>
            On which frame to show the surface vertex
        </Documentation>
      </IntVectorProperty>

      <DoubleVectorProperty
        name="errSurf"
        command="SeterrSurf"
        label="Erreur BFS Surface / Beta random Walker"
        number_of_elements="1"
        default_values="0.0">
        <Documentation>
           Seuil méthode addition surface  
        </Documentation>
      </DoubleVectorProperty>

      <IntVectorProperty
        name="surfaceMethod"
        label="Surface Method"
        command="SetsurfaceMethod"
        number_of_elements="1"
        default_values="0"
        panel_visibility="advanced">
        <EnumerationDomain name="enum">
          <Entry value="0" text="BFS algorithm"/>
          <Entry value="1" text="Random Walker"/>
        </EnumerationDomain>
        <Hints>
          <PropertyWidgetDecorator type="GenericDecorator"
                                   mode="visibility"
                                   property="Backend"
                                   value="2" />
        </Hints>
        <Documentation>
          Surface method
        </Documentation>
      </IntVectorProperty>     


      <DoubleVectorProperty
        name="filtreX"
        command="SetfiltreX"
        label="filtre traj vecteur 1 0 0"
        number_of_elements="1"
        default_values="1.0">
        <Documentation>
           Seuil méthode addition surface  
        </Documentation>
      </DoubleVectorProperty>

      <DoubleVectorProperty
        name="filtreY"
        command="SetfiltreY"
        label="filtre traj vecteur 0 1 0"
        number_of_elements="1"
        default_values="1.0">
        <Documentation>
           Seuil méthode addition surface  
        </Documentation>
      </DoubleVectorProperty>

       <DoubleVectorProperty
        name="cosCol"
        command="SetcosCol"
        label="Coefficient colinéarité fusion"
        number_of_elements="1"
        default_values="0.96">
        <Documentation>
           Coefficient mininum de colinéarité pour la fusion  
        </Documentation>
      </DoubleVectorProperty>

       <DoubleVectorProperty
        name="maxRadus"
        command="SetmaxRadus"
        label="Rayon max ptTh fusion"
        number_of_elements="1"
        default_values="40.0">
        <Documentation>
           Seuil méthode addition surface  
        </Documentation>
      </DoubleVectorProperty>

      <IntVectorProperty
        name="maxFrameDist"
        command="SetmaxFrameDist"
        label="Max Frame Dist Fusion"
        number_of_elements="1"
        default_values="20">
        <Documentation>
        </Documentation>
      </IntVectorProperty>

    <IntVectorProperty
        name="minFrameDist"
        command="SetminFrameDist"
        label="Min Frame Dist Fusion"
        number_of_elements="1"
        default_values="0">
        <Documentation>
        </Documentation>
      </IntVectorProperty>

    <DoubleVectorProperty
        name="spatialScale"
        command="SetspatialScale"
        label="Spatial Scale"
        number_of_elements="1"
        default_values="1.0">
        <Documentation>
            Spatial Scale (1mm = ? pixel)
        </Documentation>
      </DoubleVectorProperty>

    <DoubleVectorProperty
        name="interFrame"
        command="SetinterFrame"
        label="InterFrame"
        number_of_elements="1"
        default_values="1.0">
        <Documentation>
           Inter Frame in μs 
        </Documentation>
      </DoubleVectorProperty>


    <IntVectorProperty
        name="convertDur"
        command="SetconvertDur"
        label="Convert durations into sec ?"
        number_of_elements="1"
        default_values="0"
        panel_visibility="advanced">
        <BooleanDomain name="bool"/>
        <Documentation>
           Durations is shown in frames or seconds ? 
        </Documentation>
      </IntVectorProperty>


    <IntVectorProperty
        name="extendTraj"
        command="SetextendTraj"
        label="Extend Traj ?"
        number_of_elements="1"
        default_values="0"
        panel_visibility="advanced">
        <BooleanDomain name="bool"/>
        <Documentation>
        </Documentation>
      </IntVectorProperty>

    <DoubleVectorProperty
        name="minVx"
        command="SetminVx"
        label="Min VX"
        number_of_elements="1"
        default_values="0.0">
        <Documentation>
           Minimum VX 
        </Documentation>
      </DoubleVectorProperty>

    <IntVectorProperty
        name="coordCratere"
        command="SetcoordCratere"
        label="coord cratere"
        number_of_elements="2"
        default_values="0 0">
        <Documentation>
        </Documentation>
      </IntVectorProperty>

    <DoubleVectorProperty
        name="threshCratereAngle"
        command="SetthreshCratereAngle"
        label="Angle(rad) between traj and cratere with endTraj"
        number_of_elements="1"
        default_values="0.0">
        <Documentation>
        </Documentation>
      </DoubleVectorProperty>

      <IntVectorProperty
        name="maxX"
        command="SetmaxX"
        label="Max X"
        number_of_elements="1"
        default_values="-1">
        <Documentation>
        </Documentation>
      </IntVectorProperty>

      <IntVectorProperty
        name="maxY"
        command="SetmaxY"
        label="Max Y"
        number_of_elements="1"
        default_values="-1">
        <Documentation>
        </Documentation>
      </IntVectorProperty>

      <IntVectorProperty
        name="minY"
        command="SetminY"
        label="Min Y"
        number_of_elements="1"
        default_values="-1">
        <Documentation>
        </Documentation>
      </IntVectorProperty>

      <IntVectorProperty
        name="minX"
        command="SetminX"
        label="Min X"
        number_of_elements="1"
        default_values="-1">
        <Documentation>
        </Documentation>
      </IntVectorProperty>

      <!-- DEBUG WIDGETS -->
      ${DEBUG_WIDGETS}

      <OutputPort name="Traj Table" index="0" id="port1"/>
      <OutputPort name="Traj VTU" index="1" id="port1"/>
      <OutputPort name="Surface VTI" index="2" id="port2"/>
      <OutputPort name="New Traj" index="3" id="port3"/>
      <OutputPort name="Merge" index="4" id="port4"/>
      <OutputPort name="Inital" index="5" id="port5"/>

      <!-- MENU CATEGORY -->
      <Hints>
        <ShowInMenu category="TTK - Misc"/>
      </Hints>
    </SourceProxy>
  </ProxyGroup>
</ServerManagerConfiguration>

