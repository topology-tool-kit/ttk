<?xml version="1.0" encoding="UTF-8"?>
<ServerManagerConfiguration>
  <ProxyGroup name="filters">
    <SourceProxy name="ttkTrajectoryStatistics" class="ttkTrajectoryStatistics" label="TTK TrajectoryStatistics">
      <Documentation long_help="Trajectory Stat" short_help="Trajectory statistics after Tracking From Field"/>

      <!-- INPUT DATA OBJECT -->
      <InputProperty name="InputGrid" command="SetInputConnection" port_index="0">
        <ProxyGroupDomain name="groups">
          <Group name="sources"/>
          <Group name="filters"/>
        </ProxyGroupDomain>
        <DataTypeDomain name="input_type">
          <DataType value="vtkUnstructuredGrid"/>
        </DataTypeDomain>
        <Documentation>Output From TrackingFromField.</Documentation>
      </InputProperty>

      <InputProperty name="InputSet" command="SetInputConnection" port_index="1">
        <ProxyGroupDomain name="groups">
          <Group name="sources"/>
          <Group name="filters"/>
        </ProxyGroupDomain>
        <DataTypeDomain name="input_type">
          <DataType value="vtkDataSet"/>
        </DataTypeDomain>
        <Documentation>Initial Data</Documentation>
      </InputProperty>

      <!-- OUTPUT PARAMETER WIDGETS -->



      <IntVectorProperty
        name="frameSurface"
        command="SetframeSurface"
        label="Frame Surface"
        number_of_elements="1"
        default_values="0">
        <Documentation>
            On which frame to show the surface vertex
        </Documentation>
      </IntVectorProperty>

      <DoubleVectorProperty
        name="errSurf"
        command="SeterrSurf"
        label="Erreur BFS Surface"
        number_of_elements="1"
        default_values="0.0">
        <Documentation>
           Seuil méthode addition surface  
        </Documentation>
      </DoubleVectorProperty>

       <IntVectorProperty
        name="addThresh"
        command="SetaddThresh"
        label="Méthode addition surface"
        number_of_elements="1"
        default_values="1"
        panel_visibility="advanced">
        <BooleanDomain name="bool"/>
        <Documentation>
           Méthode addition estimation surface 
        </Documentation>
      </IntVectorProperty>

       <IntVectorProperty
        name="gradThresh"
        command="SetgradThresh"
        label="Méthode norme gradient surface"
        number_of_elements="1"
        default_values="0"
        panel_visibility="advanced">
        <BooleanDomain name="bool"/>
        <Documentation>
           Méthode norme gradient estimation surface 
        </Documentation>
      </IntVectorProperty> 


      <!-- DEBUG WIDGETS -->
      ${DEBUG_WIDGETS}

      <OutputPort name="Traj Table" index="0" id="port1"/>
      <OutputPort name="Traj VTU" index="1" id="port1"/>
      <OutputPort name="Surface VTI" index="2" id="port2"/>


      <!-- MENU CATEGORY -->
      <Hints>
        <ShowInMenu category="TTK - Misc"/>
      </Hints>
    </SourceProxy>
  </ProxyGroup>
</ServerManagerConfiguration>

