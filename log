-           - double(NeighborhoodSize) / (n_ - 1))
-          / (1 - double(NeighborhoodSize) / (n_ - 1));
-  mrreh_ = inputMRRESum / normalizingMRRE;
-  mrrel_ = latentMRRESum / normalizingMRRE;
-}
